<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="hotelPU" transaction-type="RESOURCE_LOCAL">

        <class>com.hotelmanagement.model.entity.KhachHang</class>
        <class>com.hotelmanagement.model.entity.NhanVien</class>
        <class>com.hotelmanagement.model.entity.LoaiPhong</class>
        <class>com.hotelmanagement.model.entity.Phong</class>
        <class>com.hotelmanagement.model.entity.DatPhong</class>
        <class>com.hotelmanagement.model.entity.ChiTietDatPhong</class>
        <class>com.hotelmanagement.model.entity.DichVu</class>
        <class>com.hotelmanagement.model.entity.ChiTietDichVu</class>
        <class>com.hotelmanagement.model.entity.HoaDon</class>
        <class>com.hotelmanagement.model.entity.BaoTri</class>
        <class>com.hotelmanagement.model.entity.ChuyenPhong</class>


        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/QLKS?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Ho_Chi_Minh"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="mtuyen123"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
        </properties>

    </persistence-unit>
</persistence>